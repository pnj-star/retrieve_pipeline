# ============================================================
# retrieve_skill 配置模板（.env.example）
# ------------------------------------------------------------
# 使用方法：复制成 .env 后按自己的环境填写，不要直接改本文件。
#   Windows:  Copy-Item .env.example .env
#   Linux:    cp .env.example .env
# .env 会被 .gitignore 忽略，不会进仓库；本文件只负责说明每个变量。
# 代码里几乎所有变量都有默认值，留空就是走默认行为，不用每项都硬填。
# ============================================================

# --- LLM（OpenAI 兼容；本 skill 只用于查询改写）---
# 查询改写（llm_rewrite / query_expansion）要调的 OpenAI 兼容接口地址。
# 示例：https://api.openai.com/v1、https://your-gateway.example.com/v1。
# 关闭查询改写（RETRIEVAL_QUERY_REWRITE_MODE=off）时可以留空。
LLM_BASE_URL=

# LLM 接口密钥。只存在 .env 里，不要提交到仓库或写死进代码。
LLM_API_KEY=

# 查询改写使用的模型名，例如 gpt-4o-mini / deepseek-v4-flash / qwen-plus。
# 留空使用 common_core 提供的默认模型名。
LLM_MODEL=

# 采样温度：0 = 完全确定，改写类任务建议 0。
LLM_TEMPERATURE=0

# 单次 LLM 输出的最大 token 数；改写输出很短，2048 是宽松上限。
LLM_MAX_TOKENS=2048

# LLM 请求超时（秒）。网关慢或不稳定时可调到 60。
LLM_TIMEOUT_SECONDS=30

# --- 稠密检索 Embedding ---
# 本地 Embedding 模型名，稠密向量维度必须和 Milvus 集合里已写入的向量一致。
# 常见选择：BAAI/bge-small-zh-v1.5（512 维）、BAAI/bge-base-zh-v1.5（768 维）、
# BAAI/bge-m3（1024 维）。换模型必须重建集合并重新灌向量，不能只改这一行。
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# --- Milvus（稠密向量 + BM25 混合检索）---
# Milvus 服务地址；本机 Docker 是 127.0.0.1，跨机器填内网 IP 或域名。
MILVUS_HOST=127.0.0.1

# gRPC 端口。Milvus 默认 19530；Docker 做了端口映射就填映射后的端口（如 19531）。
MILVUS_PORT=19530

# 启用 Milvus 用户鉴权时填用户名；未启用留空。
MILVUS_USER=

# 对应密码；未启用鉴权留空。
MILVUS_PASSWORD=

# TLS 开关：true / false。公网或云 Milvus 开了 HTTPS 填 true，本地默认 false。
MILVUS_SECURE=false

# Milvus 数据库名；留空表示默认 default 库。
MILVUS_DB=

# 文本子块集合名。集合必须已存在且已写入向量，否则检索直接报错。
MILVUS_TEXT_COLLECTION=knowledge_kb

# 检索返回字段，逗号分隔，必须是集合 schema 里真实存在的字段。
# id 是子块主键（评估/回答节点靠它回查具体子块），content 是子块正文；
# parent_* 是父块信息，用于父块聚合与去重，集合里没有就删掉对应字段。
# 请求 schema 中不存在的字段会让稠密/BM25 两路同时失败，务必和集合对齐。
MILVUS_OUTPUT_FIELDS=id,content,parent_id,chunk_index,tenant_id,kb_id,doc_version

# --- MySQL（父块权威内容）---
# 父块全文只存 MySQL 的 rag_parent_block 表；Milvus 只存子块和 parent_id。
# retrieve_skill 进程在 Docker Compose 网络内用服务名和容器端口：
#   MYSQL_HOST=test-mysql
#   MYSQL_PORT=3306
# 直接跑在 Windows 宿主机时使用宿主机地址和映射端口。
# 本地 test-mysql 容器的常见映射是 127.0.0.1:3307 -> 容器内 3306。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307

# 父块数据所在的数据库、账号和表。root 仅建议本地开发使用。
MYSQL_DATABASE=rag_test
MYSQL_USER=root

# 填 test-mysql 的 root 密码；不要提交真实密码到仓库。
MYSQL_PASSWORD=

# 连接与连接池参数；本地默认值即可，生产按数据库负载调整。
MYSQL_CHARSET=utf8mb4
MYSQL_CONNECT_TIMEOUT=3
MYSQL_READ_TIMEOUT=5
MYSQL_POOL_MAX_CONNECTIONS=10

# 父块表名和可见状态。检索只会回源 status 等于 RAG_PARENT_STATUS 的父块。
RAG_PARENT_TABLE=rag_parent_block
RAG_PARENT_STATUS=active

# 父块回源后的 token 预算。MAX_DOC_TOKENS 为 0 时自动取总预算一半。
CONTEXT_MAX_TOKENS=6000
MAX_DOC_TOKENS=3000

# --- Redis（精排结果缓存）---
# 缓存“完整检索签名 -> 精排后父块引用”。Redis 不可用时会自动降级为真实检索，
# 功能不坏但每个请求会更慢；企业环境建议常开。
REDIS_HOST=127.0.0.1

# Redis 默认端口 6379，按实例配置修改。
REDIS_PORT=6379

# Redis 密码；没开 auth 留空。
REDIS_PASSWORD=

# Redis 逻辑库编号，0~15；不同业务可分开用避免互相干扰。
REDIS_DB=0

# 检索缓存过期时间（秒）。知识库更新频繁就调小（如 300），想省成本可调大。
REDIS_DEFAULT_TTL=1800

# 缓存 key 前缀。多个业务共用一套 Redis 时建议用不同前缀，例如 rag / faq。
REDIS_KEY_PREFIX=rag

# Redis 连接超时（秒）。值越小，Redis 挂掉时降级越快；太大单请求会卡很久。
REDIS_SOCKET_TIMEOUT=3

# --- 检索与精排 ---
# 稠密检索、BM25 检索各自拉回的候选数。越大召回越高，但耗时和重排成本也越高。
RETRIEVAL_TOP_K=20

# 相关性门控阈值：ce_score >= 阈值的子块才保留并参与父块引用聚合；
# 如果所有子块都低于阈值，则返回 status=no_context、docs=[]，也不写缓存。
# 注意：ce_score 是交叉编码器原始分（限制在 [0,1]），不是带权重的融合分 score；
# 融合分 score = ce_score × RERANKER_CE_WEIGHT + 检索原始分 × RERANKER_RETRIEVAL_WEIGHT。
# ce_score 的量纲由 RERANKER_MODEL 决定，必须实测你的语料分数分布后再定：
# 0 = 不门控，0.9 = 极严格。不要照抄别人的 0.70。
RETRIEVAL_MIN_RELEVANCE=0.70

# 混合检索并发 worker 数。机器核少可降到 8 或 4，避免线程池过载。
RETRIEVAL_HYBRID_WORKERS=16

# RRF 融合后返回的候选数，决定送进重排器的文档数量。
RRF_TOP_K=20

# RRF 平滑系数 k，一般 60 附近；数值越大排名差异越平滑。
RRF_K=60

# 重排后最终返回给 agent 的文档数；越大上下文越满，越小越可能漏答案。
RERANK_TOP_K=3

# --- 查询改写（默认 off）---
# 三种模式怎么选：
#   off             不改写，用户 query 直接进混合检索；零 LLM 成本、延迟最低，先跑这个基线。
#   llm_rewrite     用 LLM 把口语化/指代不清的问题改写成一条更利于检索的查询；
#                   适合"保留原意、换一种说法后召回明显变好"的场景。
#   query_expansion 用 LLM 生成多条查询变体，分别检索后合并，提升召回；
#                   适合答案分散在多篇文档、单条查询召回不足的场景，代价是多次检索和更多 token。
# 选择建议：先 off 跑通基线并量化召回；确实不足再开 llm_rewrite；
# 最后才考虑 query_expansion。开 LLM 模式前必须先配好 LLM_BASE_URL / LLM_API_KEY / LLM_MODEL；
# 改写失败会自动回退原 query，不会阻塞检索。
RETRIEVAL_QUERY_REWRITE_MODE=off

# 改写专用模型名；留空则复用管线默认 LLM 模型。
RETRIEVAL_QUERY_REWRITE_LLM_MODEL=

# 改写采样温度，建议 0，保证同一问题每次改写稳定。
RETRIEVAL_QUERY_REWRITE_TEMPERATURE=0

# 改写输出最大 token 数，256 通常够用。
RETRIEVAL_QUERY_REWRITE_MAX_TOKENS=256

# query_expansion 生成的查询变体数量。变体越多召回越高，但越慢越贵。
RETRIEVAL_QUERY_REWRITE_EXPAND_COUNT=2

# 自定义单条改写 prompt；留空使用内置默认 prompt。
RETRIEVAL_QUERY_REWRITE_PROMPT=

# 自定义展开 prompt，必须包含 {count} 占位符；留空使用内置默认。
RETRIEVAL_QUERY_REWRITE_EXPANSION_PROMPT=

# 按 tenant/kb 覆盖改写模式，逗号分隔，例如：
#   t1/kb1=llm_rewrite,t2/*=query_expansion
# 支持 tenant/*、*/kb、*/*；留空表示所有租户都走上面的 MODE。
RETRIEVAL_QUERY_REWRITE_SCOPES=

# --- 交叉编码器重排器 ---
# 重排模型名。bge-reranker-base 轻量；效果更强的 bge-reranker-v2-m3
# 更慢、更吃内存。换模型后相关性分分布会变，需重新标定阈值。
RERANKER_MODEL=BAAI/bge-reranker-base

# 融合分 score 中 ce_score 的权重（0~1）。0.6 表示更看重重排器的相关性判断。
# 注意：RETRIEVAL_MIN_RELEVANCE 比较的是 ce_score，不是融合分 score。
RERANKER_CE_WEIGHT=0.6

# 融合分 score 中粗检索原始分数的权重。建议和 CE 权重相加为 1（例如 0.6 + 0.4）。
RERANKER_RETRIEVAL_WEIGHT=0.4

# 重排器运行设备。留空自动探测（有 GPU 优先 cuda）；强制 CPU 写 cpu，强制 GPU 写 cuda。
RERANKER_DEVICE=

# --- Prometheus 指标（生产环境建议开启）---
# true 时启动 /metrics 指标服务；false 完全关闭，省一点开销。
# 上线后建议保持 true，否则召回率、延迟、精排分分布不可观测。
METRICS_ENABLED=false

# 指标名前缀，例如 rag_retrieval_xxx；多服务部署时避免前缀撞名。
METRICS_PREFIX=rag

# /metrics 监听端口，注意不要和 MCP 服务端口冲突。
METRICS_PORT=9090

# 监听地址：127.0.0.1 只允许本机抓取；0.0.0.0 允许外部 Prometheus 抓取，注意暴露风险。
METRICS_BIND=127.0.0.1

# --- JWT 鉴权 ---
# jwt=校验调用方 Bearer token；disabled=不做鉴权，只适合本地开发/离线评测，严禁上生产。
AUTH_MODE=jwt

# HS256 签名密钥，生产必填，建议至少 32 字节随机串；绝对不要提交仓库。
# AUTH_JWT_SECRET=

# 期望的 token issuer（签发方）声明；留空不校验。
# AUTH_JWT_ISSUER=

# 期望的 audience（受众）声明；留空不校验。
# AUTH_JWT_AUDIENCE=

# RS256/ES256 用的 PEM 公钥/证书；用非对称算法时填。
# AUTH_JWT_PUBLIC_KEY=

# 企业 IdP 的 JWKS 端点（例如 Keycloak / Auth0 / Okta 的 certs URL）。
# 配置后无需静态公钥：进程按 AUTH_JWKS_LIFESPAN 缓存公钥集合，遇到新 kid
# 或缓存过期会自动重新拉取，签名密钥轮换不需要重启 MCP 服务。
# 注意：AUTH_JWKS_URL 与 AUTH_JWT_SECRET / AUTH_JWT_PUBLIC_KEY 三选一；
# 同时配置时静态密钥优先，轮换期间请移除静态键再启用 JWKS。
# AUTH_JWKS_URL=https://idp.example.com/realms/main/protocol/openid-connect/certs

# JWKS 公钥集合缓存秒数，默认 300；到期或遇到未知 kid 时自动刷新。
# AUTH_JWKS_LIFESPAN=300

# 拉取 JWKS 的 HTTP 超时秒数，默认 30。
# AUTH_JWKS_TIMEOUT=30

# 允许的签名算法，逗号分隔，例如 HS256 / RS256 / ES256。
# 配置 AUTH_JWKS_URL 后如不显式声明，将默认启用 RS256/ES256。
# AUTH_JWT_ALGORITHMS=HS256

# MCP OAuth / 资源服务器模式相关配置，按你接入的平台文档填。
# AUTH_MCP_ISSUER_URL=
# AUTH_MCP_RESOURCE_SERVER_URL=
