# rag_skill 最小运行配置示例（占位符，勿填真实值）。
# 环境变量前缀与 common_core 保持一致；rag_skill 通过 RuntimeConfig.from_env() 读取。
# 真实 .env 不要提交：它已被 .gitignore 忽略，只有本 .env.example 会进入仓库。
#
# --- LLM（OpenAI 兼容）---
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=replace-me
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=30
#
# 本地 Embedding 模型名（全局键，非 LLM_ 前缀）
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
#
# --- Milvus（混合检索：稠密 + BM25 稀疏）---
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_USER=
MILVUS_PASSWORD=
MILVUS_SECURE=false
MILVUS_DB=
MILVUS_TEXT_COLLECTION=knowledge_kb
MILVUS_OUTPUT_FIELDS=id,content,source,category,parent_content,parent_title,chunk_index,tenant_id,kb_id
#
# --- Redis（响应缓存）---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_DEFAULT_TTL=1800
REDIS_KEY_PREFIX=rag
REDIS_SOCKET_TIMEOUT=3
#
# --- 检索与精排阈值 ---
RETRIEVAL_TOP_K=20
RETRIEVAL_MIN_RELEVANCE=0.70
RETRIEVAL_HYBRID_WORKERS=16
# 拼入 LLM 提示词的上下文总字符预算（默认 8000）
# RETRIEVAL_ASSEMBLY_MAX_CHARS=8000
RRF_TOP_K=20
RRF_K=60
RERANK_TOP_K=3
#
# --- 查询改写（默认 off）---
RETRIEVAL_QUERY_REWRITE_MODE=off
RETRIEVAL_QUERY_REWRITE_LLM_MODEL=
RETRIEVAL_QUERY_REWRITE_TEMPERATURE=0
RETRIEVAL_QUERY_REWRITE_MAX_TOKENS=256
RETRIEVAL_QUERY_REWRITE_EXPAND_COUNT=2
# RETRIEVAL_QUERY_REWRITE_PROMPT=
# RETRIEVAL_QUERY_REWRITE_EXPANSION_PROMPT=
# 按作用域覆盖：t1/kb1=llm_rewrite,t2/*=query_expansion
# RETRIEVAL_QUERY_REWRITE_SCOPES=
#
# --- 交叉编码器重排器 ---
RERANKER_MODEL=BAAI/bge-reranker-base
# 融合分中交叉编码器分数的权重（默认 0.6）
# RERANKER_CE_WEIGHT=0.6
# 融合分中检索原始分数的权重（默认 0.4）
# RERANKER_RETRIEVAL_WEIGHT=0.4
# RERANKER_DEVICE=cpu
#
# --- Prometheus 指标（默认关）---
METRICS_ENABLED=false
METRICS_PREFIX=rag
METRICS_PORT=9090
METRICS_BIND=127.0.0.1
#
# --- JWT 鉴权（默认 jwt；无密钥时由调用方决定校验策略）---
AUTH_MODE=jwt
# AUTH_JWT_SECRET=
# AUTH_JWT_ISSUER=
# AUTH_JWT_AUDIENCE=
#
# 可选（按具体部署填充）
# AUTH_JWT_PUBLIC_KEY=
# AUTH_JWT_ALGORITHMS=HS256
# AUTH_MCP_ISSUER_URL=
# AUTH_MCP_RESOURCE_SERVER_URL=
